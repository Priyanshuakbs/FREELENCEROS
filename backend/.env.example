NODE_ENV=production
PORT=10000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_strong_jwt_secret_key
JWT_EXPIRE=30d
FRONTEND_URL=https://your-frontend.onrender.com
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
# Production email provider (recommended): Brevo over HTTPS
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified_sender@yourdomain.com
BREVO_SENDER_NAME=FreelanceOS

# Free/no-domain production option: Gmail API over HTTPS
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com

# Optional fallback: Gmail SMTP (works on local/dev; may fail on some hosts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
# SMTP_SECURE=false

# Optional: Resend
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM=onboarding@resend.dev

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
